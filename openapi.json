  "info": {
    "title": "Todolist API",
    "description": "Sample Backend for simple todolist api",
    "version": "1",
    "contact": {

    }
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateTodolistDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "i am todolist title",
            "description": "Title for todolist"
          },
          "status": {
            "type": "boolean",
            "example": false,
            "description": "Todolist status"
          }
        },
        "required": [
          "title"
        ]
      },
      "ResponseTodolistDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "Generated todolist id"
          },
          "title": {
            "type": "string",
            "description": "Todolist title"
          },
          "status": {
            "type": "boolean",
            "description": "Todolist status"
          }
        },
        "required": [
          "id",
          "title",
          "status"
        ]
      },
      "UpdateTodolistDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "i am todolist title",
            "description": "Title for todolist"
          },
          "status": {
            "type": "boolean",
            "example": false,
            "description": "Todolist status"
          }
        }
      },
      "CreateTodoDto": {
        "type": "object",
        "properties": {
          "todolistId": {
            "type": "number",
            "example": 1234,
            "description": "todolistId that is attached to this todo"
          },
          "message": {
            "type": "string",
            "example": "i am todo message",
            "description": "Message for a todo"
          },
          "status": {
            "type": "boolean",
            "example": false,
            "description": "todo status"
          }
        },
        "required": [
          "todolistId",
          "message"
        ]
      },
      "ResponseTodoDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "todo id"
          },
          "message": {
            "type": "string",
            "description": "todo message"
          },
          "status": {
            "type": "boolean",
            "description": "todo status"
          }
        },
        "required": [
          "id",
          "message",
          "status"
        ]
      },
      "UpdateTodoDto": {
        "type": "object",
        "properties": {

        }
      },
      "ResponseUserMeDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "username of user"
          }
        },
        "required": [
          "username"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "foo_bar",
            "description": "Any username"
          }
        }
      },
      "DeleteUserDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "foo_bar",
            "description": "confirmation username to delete account"
          }
        },
        "required": [
          "username"
        ]
      },
      "SignUpDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "foo_bar",
            "description": "Any username"
          },
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "example": "T3sting!",
            "description": "password must include uppercase, lowercase, number, special character, and no spaces",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "username",
          "email",
          "password"
        ]
      },
      "SignInDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "User email address"
          },
          "password": {
            "type": "string",
            "example": "T3sting!",
            "description": "password must include uppercase, lowercase, number, special character, and no spaces",
            "minLength": 8,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "ResponseSignInDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "bearer token"
          }
        },
        "required": [
          "token"
        ]
      }
    }
  }
}